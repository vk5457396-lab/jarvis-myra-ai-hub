# Server
PORT=8080
NODE_ENV=production

# Comma separated list of allowed origins. Use * to allow all (Android apps send no Origin).
CORS_ORIGINS=https://codeninjavik.in,https://www.codeninjavik.in

# Supabase (server side only - NEVER expose the service role key to a client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT used for device activation tokens
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=365d

# Shared secret required by admin endpoints (reset / deactivate / renew)
ADMIN_API_KEY=replace-with-a-strong-random-admin-key

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
